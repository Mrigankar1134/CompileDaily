# Copy this file to .env for local runs. On Render/Railway, set these as
# dashboard environment variables instead of committing a .env file.

# Neon Postgres connection string (rotate the one that was pasted in chat —
# treat it as burned — then paste the NEW one here).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google Gemini API key used server-side only for the doubt-solving chat and
# auto-generated assessments. Never put this in assets/index.html. Get one at
# https://aistudio.google.com/apikey (Gemini's free tier has a generous quota).
GEMINI_API_KEY=AIza...

# Model used for doubt-solving and assessment generation. gemini-2.5-flash is
# the recommended default: fast and cheap, and plenty accurate for tutoring-style
# Java/Spring/Selenium answers and quiz generation. Switch to gemini-2.5-pro (or
# whatever Google's current flagship model is) for noticeably better reasoning
# at higher cost/latency per call.
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated list of allowed origins for CORS. The Android WebView
# sends Origin: null (loaded from file://), so "null" must stay in this list.
ALLOWED_ORIGINS=null,http://localhost:8000

PORT=8080
