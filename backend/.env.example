# Copy this file to .env for local runs. On Render/Railway, set these as
# dashboard environment variables instead of committing a .env file.

# Neon Postgres connection string (rotate the one that was pasted in chat —
# treat it as burned — then paste the NEW one here).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# OpenAI API key used server-side only for the doubt-solving chat and
# auto-generated assessments. Never put this in assets/index.html.
OPENAI_API_KEY=sk-...

# Model used for doubt-solving and assessment generation. gpt-4o-mini is the
# recommended default: cheap and fast, and plenty accurate for tutoring-style
# Java/Spring/Selenium answers and quiz generation. If answers ever feel
# shallow, switch to gpt-4o (or whatever OpenAI's current flagship model is)
# for noticeably better reasoning at higher cost per call.
OPENAI_MODEL=gpt-4o-mini

# Comma-separated list of allowed origins for CORS. The Android WebView
# sends Origin: null (loaded from file://), so "null" must stay in this list.
ALLOWED_ORIGINS=null,http://localhost:8000

PORT=8080
